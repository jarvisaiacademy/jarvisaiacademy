# ==========================================
# Jarvis AI Academy — Environment Configuration
# ==========================================

# ------------------------------------------
# 1. Firebase Client Configuration
# (Get these from Firebase Console > Project settings > General > Your apps)
# ------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=jarvisaiacademy.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=jarvisaiacademy
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=jarvisaiacademy.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------
# 2. Administrator Access Control
# Comma-separated Google account emails with Admin Dashboard access
# ------------------------------------------
NEXT_PUBLIC_ADMIN_EMAILS=sugat@jarvisaiacademy.com

# ------------------------------------------
# 3. Optional Google OAuth 2.0 Direct Keys
# ------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
